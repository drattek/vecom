# Copia este archivo a `.env` y ajusta los valores según tu entorno local.
# Vite solo expone al cliente las variables con prefijo VITE_.

# Destino al que el dev server (npm run dev) reenvía las llamadas a /api.
# Debe apuntar a core-orchestrator. Por defecto sirve HTTPS en :443
# (ver SERVER_PORT en el .env raíz y docker-compose.yml).
# Si corres core-orchestrator en otro puerto/host, cámbialo aquí.
VITE_API_PROXY_TARGET=https://localhost:443

# baseURL de axios (src/lib/api.ts). Déjalo vacío para usar rutas relativas
# ("/api/...") y que el proxy del dev server o nginx resuelvan el destino.
# Solo defínelo si el frontend debe llamar directamente a un host absoluto.
# VITE_API_BASE_URL=
