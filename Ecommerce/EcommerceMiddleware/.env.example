# =====================================================================
# Plantilla de variables de entorno para EcommerceMiddleware.
# Copia a .env y rellena los valores reales:  cp .env.example .env
# NUNCA commitees el .env (ya esta en .gitignore).
# =====================================================================

# ---------- Servidor ----------
SERVER_PORT=8080
# En Azure Container Apps el TLS lo termina el ingress -> dejar en false.
SERVER_SSL_ENABLED=false
# Solo si SERVER_SSL_ENABLED=true
SERVER_SSL_KEYSTORE=classpath:keystore.p12
SERVER_SSL_KEYSTORE_PASSWORD=
SERVER_SSL_KEYSTORE_TYPE=PKCS12
SERVER_SSL_KEY_ALIAS=tomcat

# ---------- Integracion activa ----------
INTEGRATION_COMPANY_NAME=MULTIVENDE

# ---------- BD 1: Azure MySQL (middleware) ----------
MW_DB_URL=jdbc:mysql://<servidor>.mysql.database.azure.com:3306/<basededatos>
MW_DB_USERNAME=<usuario>
MW_DB_PASSWORD=<password>
MW_DB_DRIVER=com.mysql.cj.jdbc.Driver

# ---------- BD 2: Azure Synapse / Dataverse (ERP) ----------
MSB_DB_URL=jdbc:sqlserver://<servidor>.sql.azuresynapse.net:1433;databaseName=<basededatos>;encrypt=true;trustServerCertificate=false;authentication=ActiveDirectoryServicePrincipal
# Con ActiveDirectoryServicePrincipal: username = client id, password = client secret
MSB_DB_USERNAME=<client-id>
MSB_DB_PASSWORD=<client-secret>
MSB_DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
MSB_DB_DIALECT=org.hibernate.dialect.SQLServerDialect

# ---------- CORS ----------
# Lista separada por comas de origenes permitidos.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500

# ---------- Actuator ----------
MANAGEMENT_ENDPOINTS=health,info
# false = el health no depende de que las BD externas respondan.
MANAGEMENT_HEALTH_DB_ENABLED=false

# ---------- Servicios externos ----------
WEBSCRAPER_API_BASE_URL=http://localhost:8080/veg-web-scraper
JUMPSELLER_API_BASE_URL=https://api.jumpseller.com/v1
MERCADOLIBRE_API_BASE_URL=https://api.mercadolibre.com
CAMSO_API_BASE_URL=https://api.michelin.com
MULTIVENDE_API_BASE_URL=https://app.multivende.com

# ---------- JVM ----------
JAVA_OPTS=-XX:MaxRAMPercentage=75
