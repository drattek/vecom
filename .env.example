# Synapse

ERP_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
ERP_JDBC_URL=jdbc:sqlserver://dyn365fosyn-ondemand.sql.azuresynapse.net:1433;databaseName=dataverse_vegusa_unq1552bea2e8d74bffb367119adb1a7;encrypt=true;trustServerCertificate=false;authentication=ActiveDirectoryServicePrincipal
ERP_USERNAME=replace-with-erp-username
ERP_PASSWORD=replace-with-erp-password
ERP_POOL_SIZE=10
ERP_CONNECTION_TIMEOUT=60000

# NISSAN
NISSAN_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
NISSAN_JDBC_URL=jdbc:sqlserver://autos.database.windows.net:1433;databaseName=autos
NISSAN_USERNAME=replace-with-nissan-username
NISSAN_PASSWORD=replace-with-nissan-password

# Fabric (SQL analytics endpoint del lakehouse/warehouse — solo lectura)
# database = nombre del lakehouse/warehouse, nunca el GUID.
# username = client id del service principal; password = secret.
FABRIC_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
FABRIC_JDBC_URL=jdbc:sqlserver://replace-with-fabric-host.datawarehouse.fabric.microsoft.com:1433;database=replace-with-lakehouse-name;encrypt=true;trustServerCertificate=false;authentication=ActiveDirectoryServicePrincipal;loginTimeout=30
FABRIC_USERNAME=replace-with-fabric-service-principal-client-id
FABRIC_PASSWORD=replace-with-fabric-service-principal-secret
FABRIC_POOL_SIZE=3
FABRIC_CONNECTION_TIMEOUT=60000
FABRIC_MAX_LIFETIME=1800000

# MySQL (Core Orchestrator)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=replace-with-mysql-user
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=ecommerce
# Pool de conexiones (opcional; valores por defecto entre paréntesis)
MYSQL_MAX_OPEN_CONNS=25
MYSQL_MAX_IDLE_CONNS=25
MYSQL_CONN_MAX_LIFETIME_MINUTES=5
MYSQL_CONN_MAX_IDLE_TIME_MINUTES=5

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Server
SERVER_PORT=443
SERVER_TLS_KEYSTORE_PATH=../../keystore.p12
SERVER_TLS_KEYSTORE_PASSWORD=replace-with-keystore-password
SERVER_TLS_KEYSTORE_TYPE=PKCS12

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=core-orchestrator
JWT_TTL_MINUTES=60

# Encryption (32-byte text or base64 of 32 bytes) for ecom_connection_credentials.value when is_encrypted=true
CONNECTION_CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-key-or-base64

# Cron
# Las expresiones son hora local en SYNC_CRON_ZONE (no la del servidor). CDMX no
# observa horario de verano desde 2022, así que la zona queda fija en UTC-6 todo el año.
SYNC_STOCK_CRON=0 0 4 * * *
SYNC_ITEMS_CRON=0 0 12 * * *
SYNC_EXISTENCIAS_CRON=0 0 6 * * *
SYNC_CRON_ZONE=America/Mexico_City

# Token refresh scheduler (core-orchestrator) — background job not started yet,
# see services/core-orchestrator/internal/interfaces/schedulers/token_refresh_scheduler.go
TOKEN_REFRESH_POLL_INTERVAL_MINUTES=5
TOKEN_REFRESH_LOOKAHEAD_MINUTES=15

# Banco de México SIE API (USD/MXN exchange rate updater) — see
# services/core-orchestrator/internal/infrastructure/banxico/client.go
SIE_API_TOKEN=replace-with-sie-api-token
# Hora del servidor (UTC en despliegue). 08:00 UTC = 02:00 CDMX (UTC-6).
EXCHANGE_RATE_RUN_AT_HOUR=8
EXCHANGE_RATE_RUN_AT_MINUTE=0
