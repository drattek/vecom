    <template id="website_sale_product_machine_models" inherit_id="website_sale.product" name="Compatible machine models section" priority="30">
        <xpath expr="//section[@id='product_detail']" position="inside">
            <section t-if="product.machine_model_ids" id="o_machine_catalog_product_models" class="o_machine_catalog_product_models mt-5">
                <div class="container">
                    <h3 class="o_machine_catalog_product_models__title">Maquinaria y vehículos compatibles</h3>
                    <div class="table-responsive">
                        <table class="table align-middle o_machine_catalog_product_models__table">
                            <thead>
                                <tr>
                                    <th scope="col">Modelo</th>
                                    <th scope="col">Marca</th>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Años</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="product.machine_model_ids" t-as="machine_model" t-key="machine_model.id">
                                    <tr>
                                        <td class="fw-semibold" t-esc="machine_model.name"/>
                                        <td t-esc="machine_model.brand_id.name"/>
                                        <td t-esc="machine_model.machine_type_id.name"/>
                                        <td t-esc="machine_model.year_label or ''"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
