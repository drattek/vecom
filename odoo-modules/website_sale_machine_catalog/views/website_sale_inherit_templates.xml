<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="website_sale_category_link" inherit_id="website_sale.categorie_link" name="Category link with brand preservation">
        <xpath expr="//a" position="attributes">
            <attribute name="t-att-href">shop_route_mode == 'brand' and brand and keep('/shop/brand/%s' % request.env['ir.http']._slugify(brand.name), category=c.id, machine_type=machine_type and machine_type.id or False) or (shop_route_mode == 'type' and machine_type and keep('/shop/type/%s' % request.env['ir.http']._slugify(machine_type.name), category=c.id, brand=brand and brand.id or False) or keep('/shop/category/%s' % slug(c), brand=brand and brand.id or False, machine_type=machine_type and machine_type.id or False))</attribute>
        </xpath>
    </template>

    <template id="website_sale_brand_title" inherit_id="website_sale.products" name="Brand shop title">
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title" t-value="brand and not category and brand.name or (category and category.name or '')"/>
        </xpath>
    </template>

