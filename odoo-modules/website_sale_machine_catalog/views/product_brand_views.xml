<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_brand_tree" model="ir.ui.view">
        <field name="name">machine.brand.tree.machine.catalog</field>
        <field name="model">machine.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="website_published"/>
                <field name="product_count"/>
            </list>
        </field>
    </record>

    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">machine.brand.form.machine.catalog</field>
        <field name="model">machine.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="website_published"/>
                        <field name="logo" widget="image"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_tmpl_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="default_code"/>
                                    <field name="list_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_machine_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">machine.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="product_template_form_inherit_machine_brand" model="ir.ui.view">
        <field name="name">product.template.form.machine.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_ids" widget="many2many_tags" options="{'no_create': False, 'no_open': False}"/>
            </field>
        </field>
    </record>

    <menuitem
        id="menu_machine_brand_root"
        name="Machinery &amp; Vehicles"
        sequence="85"
        groups="product.group_product_manager"
    />

    <menuitem
        id="menu_machine_brand"
        name="Brands"
        parent="menu_machine_brand_root"
        action="action_machine_brand"
        sequence="10"
        groups="product.group_product_manager"
    />
</odoo>
