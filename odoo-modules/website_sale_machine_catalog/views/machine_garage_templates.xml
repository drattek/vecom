<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="machine_garage_user_dropdown" name="Machine garage link" inherit_id="portal.user_dropdown">
        <xpath expr="//div[@id='o_logout_divider']" position="before">
            <a href="/my/garage" role="menuitem" class="dropdown-item">
                <i class="fa fa-fw fa-cubes me-1 small text-primary"/>
                Mi garage
            </a>
        </xpath>
    </template>

    <template id="machine_garage_page" name="Mi garage">
        <t t-call="website.layout">
            <div class="container py-5 o_machine_garage_page">
                <div class="row justify-content-center">
                    <div class="col-12 col-xl-10">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
                            <div>
                                <h1 class="mb-1">Mi garage</h1>
                                <p class="text-muted mb-0">Accesos rápidos a tu maquinaria y vehículos guardados.</p>
                            </div>
                            <a href="/shop" class="btn btn-outline-secondary">Ir al shop</a>
                        </div>

                        <t t-if="garage_records">
                            <div class="table-responsive">
                                <table class="table align-middle table-hover o_machine_garage_table">
                                    <thead>
                                        <tr>
                                            <th>Marca</th>
                                            <th>Tipo</th>
                                            <th>Modelo</th>
                                            <th>Año</th>
                                            <th class="text-end">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="garage_records" t-as="garage_record">
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold" t-esc="garage_record.brand_id.name"/>
                                                </td>
                                                <td t-esc="garage_record.machine_type_id.name"/>
                                                <td t-esc="garage_record.machine_model_id.name"/>
                                                <td t-esc="garage_record.vehicle_year or ''"/>
                                                <td>
                                                    <div class="d-flex justify-content-end flex-wrap gap-2">
                                                        <a t-att-href="garage_record.get_shop_url()" class="btn btn-sm btn-primary">Ver refacciones</a>
                                                        <form t-att-action="'/my/garage/%s/remove' % garage_record.id" method="post" class="d-inline">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="alert alert-light border shadow-sm">
                                <p class="mb-2">Aún no has guardado ninguna maquinaria ni vehículo.</p>
                                <a href="/shop" class="btn btn-primary btn-sm">Buscar refacciones</a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>