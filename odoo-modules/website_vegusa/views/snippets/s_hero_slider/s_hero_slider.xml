<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_hero_slider" name="Hero Slider">
    <section class="s_carousel_wrapper s_hero_slider p-0" data-vcss="001" data-name="Hero Slider" data-snippet="website_vegusa.s_hero_slider">
        <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>
        <div t-attf-id="myHeroSlider{{uniq}}" class="s_carousel s_hero_slider_carousel s_carousel_default carousel slide" data-bs-ride="true" data-bs-interval="10000">
            <!-- Content -->
            <div class="carousel-inner">
                <!-- #01 -->
                <div class="carousel-item active s_hero_slide" data-name="Slide">
                    <img class="s_hero_slide_img s_hero_slide_img_desktop d-none d-md-block oe_unremovable" src="/web/image/website.s_carousel_default_image_1" data-name="Desktop Image" alt="" draggable="false"/>
                    <img class="s_hero_slide_img s_hero_slide_img_mobile d-md-none oe_unremovable" src="/web/image/website.s_carousel_default_image_1" data-name="Mobile Image" alt="" draggable="false"/>
                </div>
                <!-- #02 -->
                <div class="carousel-item s_hero_slide" data-name="Slide">
                    <img class="s_hero_slide_img s_hero_slide_img_desktop d-none d-md-block oe_unremovable" src="/web/image/website.s_carousel_default_image_2" data-name="Desktop Image" alt="" draggable="false"/>
                    <img class="s_hero_slide_img s_hero_slide_img_mobile d-md-none oe_unremovable" src="/web/image/website.s_carousel_default_image_2" data-name="Mobile Image" alt="" draggable="false"/>
                </div>
                <!-- #03 -->
                <div class="carousel-item s_hero_slide" data-name="Slide">
                    <img class="s_hero_slide_img s_hero_slide_img_desktop d-none d-md-block oe_unremovable" src="/web/image/website.s_carousel_default_image_3" data-name="Desktop Image" alt="" draggable="false"/>
                    <img class="s_hero_slide_img s_hero_slide_img_mobile d-md-none oe_unremovable" src="/web/image/website.s_carousel_default_image_3" data-name="Mobile Image" alt="" draggable="false"/>
                </div>
            </div>
            <!-- Controls -->
            <button class="carousel-control-prev o_not_editable" contenteditable="false" t-attf-data-bs-target="#myHeroSlider{{uniq}}" data-bs-slide="prev" aria-label="Previous" title="Previous">
                <span class="carousel-control-prev-icon" aria-hidden="true"/>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next o_not_editable" contenteditable="false" t-attf-data-bs-target="#myHeroSlider{{uniq}}" data-bs-slide="next" aria-label="Next" title="Next">
                <span class="carousel-control-next-icon" aria-hidden="true"/>
                <span class="visually-hidden">Next</span>
            </button>
            <!-- Indicators -->
            <div class="carousel-indicators o_not_editable">
                <button type="button" t-attf-data-bs-target="#myHeroSlider{{uniq}}" data-bs-slide-to="0" class="active" aria-label="Carousel indicator"/>
                <button type="button" t-attf-data-bs-target="#myHeroSlider{{uniq}}" data-bs-slide-to="1" aria-label="Carousel indicator"/>
                <button type="button" t-attf-data-bs-target="#myHeroSlider{{uniq}}" data-bs-slide-to="2" aria-label="Carousel indicator"/>
            </div>
        </div>
    </section>
</template>

</odoo>
