<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Single-row header (logo, search, Mi garage, cart, menu) with two side panels: the user
         menu (vegusa_side_menu) and the garage (vegusa_garage_panel). Design reference:
         website-design/index.html. The template id stays: the website builder header option
         (header_template_option.xml) activates it by name. -->
    <template id="header" inherit_id="website.layout" name="Vegusa - Header" active="True">
        <xpath expr="//header" position="replace">
            <t t-set="vg_logged_in" t-value="not request.env.user._is_public()"/>
            <header class="o_header_fixed o_top_fixed_element vg-header" data-name="Header">
                <div class="vg-header__inner">
                    <a href="/" class="vg-brand" t-att-aria-label="website.name">
                        <picture>
                            <source media="(max-width: 575.98px)" t-attf-srcset="/web/image/website/#{website.id}/favicon"/>
                            <img class="vg-brand__logo" t-attf-src="/web/image/website/#{website.id}/logo" t-att-alt="website.name" width="95" height="40"/>
                        </picture>
                    </a>

                    <div class="vg-search">
                        <t t-call="website.website_search_box_input">
                            <t t-set="search_type" t-valuef="all"/>
                            <t t-set="action" t-valuef="/website/search"/>
                            <t t-set="placeholder" t-valuef="Encuentra tu refacción por número de parte"/>
                            <t t-set="limit" t-value="limit or '5'"/>
                            <t t-set="display_image" t-valuef="true"/>
                            <t t-set="display_description" t-valuef="true"/>
                            <t t-set="display_extra_link" t-valuef="true"/>
                            <t t-set="display_detail" t-valuef="true"/>
                        </t>
                    </div>

                    <t t-if="vg_logged_in">
                        <t t-set="vg_garage_entries" t-value="request.env['machine.garage'].sudo()._get_header_entries(request.params.get('machine_model_id'), request.params.get('vehicle_year'))"/>
                        <t t-set="vg_garage_active" t-value="[entry for entry in vg_garage_entries if entry['active']][:1]"/>
                        <button type="button" class="vg-garage-btn" data-offcanvas-open="vgGaragePanel" aria-expanded="false" aria-controls="vgGaragePanel" title="Mi garage">
                            <i class="fa fa-truck" aria-hidden="true"/>
                            <span class="vg-garage-btn__label">
                                <t t-if="vg_garage_active" t-out="vg_garage_active[0]['label']"/>
                                <t t-else="">Mi garage</t>
                            </span>
                        </button>
                    </t>
                    <a t-else="" href="/web/login" class="vg-garage-btn" title="Iniciar sesión para usar Mi garage">
                        <i class="fa fa-truck" aria-hidden="true"/>
                        <span class="vg-garage-btn__label">Mi garage</span>
                    </a>

                    <div class="vg-header__actions">
                        <a href="/shop/cart" class="vg-icon-btn" aria-label="Carrito">
                            <i class="fa fa-shopping-cart" aria-hidden="true"/>
                            <sup t-attf-class="my_cart_quantity vg-icon-btn__badge #{'d-none' if (website_sale_cart_quantity == 0) else ''}" t-out="website_sale_cart_quantity" t-att-data-order-id="request.session.get('sale_order_id', '')"/>
                        </a>
                        <button type="button" class="vg-icon-btn" data-offcanvas-open="vgSideMenu" aria-label="Abrir menú" aria-expanded="false" aria-controls="vgSideMenu">
                            <i class="fa fa-bars" aria-hidden="true"/>
                        </button>
                    </div>
                </div>
            </header>
        </xpath>
    </template>

    <!-- The side panels are rendered next to #wrapwrap, not inside the header. #wrapwrap has
         z-index: 0 (a stacking context), so anything inside it can never get above the livechat
         sticky bar, whose root element lives at body level. See header.scss (.vg-offcanvas). -->
    <template id="side_panels" inherit_id="website.layout" name="Vegusa - Side Panels" active="True">
        <xpath expr="//div[@id='wrapwrap']" position="after">
            <t t-set="vg_logged_in" t-value="not request.env.user._is_public()"/>
            <t t-call="website_vegusa.vegusa_side_menu"/>
            <t t-if="vg_logged_in" t-call="website_vegusa.vegusa_garage_panel"/>
        </xpath>
    </template>

    <!-- User menu. Items that need a session (Favoritos, Mis compras, Mi garage, Mis direcciones)
         and the user card only exist for logged-in users; the bottom button turns into
         "Iniciar sesión" for visitors. Rastrear pedido, Mis cotizaciones, Ofertas and Ventas
         por mayoreo are in the design but hidden for now. -->
    <template id="vegusa_side_menu" name="Vegusa - Side Menu">
        <div class="vg-offcanvas" id="vgSideMenu" hidden="hidden">
            <div class="vg-offcanvas__backdrop" data-offcanvas-close="1"/>
            <div class="vg-offcanvas__panel" role="dialog" aria-modal="true" aria-label="Menú de usuario">
                <div class="vg-offcanvas__top">
                    <button type="button" class="vg-offcanvas__close" data-offcanvas-close="1" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                    <div t-if="vg_logged_in" class="vg-user">
                        <span class="vg-user__avatar" aria-hidden="true">
                            <img t-attf-src="/web/image/res.partner/#{request.env.user.partner_id.id}/avatar_128" alt=""/>
                        </span>
                        <div class="vg-user__info">
                            <span class="vg-user__name" t-out="request.env.user.name"/>
                            <a href="/my/home" class="vg-user__link">Mi perfil</a>
                        </div>
                    </div>
                    <p t-else="" class="vg-offcanvas__title">Menú</p>
                </div>

                <nav class="vg-offcanvas__menu" aria-label="Opciones de cuenta">
                    <div class="vg-offcanvas__group">
                        <p class="vg-offcanvas__group-title">General</p>
                        <ul>
                            <li>
                                <a href="/"><i class="fa fa-home" aria-hidden="true"/><span>Inicio</span></a>
                            </li>
                            <li>
                                <a href="/shop"><i class="fa fa-th" aria-hidden="true"/><span>Categorías</span></a>
                            </li>
                            <t t-if="vg_logged_in" t-call="website_vegusa.vegusa_side_wishlist_item"/>
                        </ul>
                    </div>

                    <div t-if="vg_logged_in" class="vg-offcanvas__group">
                        <p class="vg-offcanvas__group-title">Mis pedidos</p>
                        <ul>
                            <li>
                                <a href="/my/orders"><i class="fa fa-shopping-bag" aria-hidden="true"/><span>Mis compras</span></a>
                            </li>
                        </ul>
                    </div>

                    <div t-if="vg_logged_in" class="vg-offcanvas__group">
                        <p class="vg-offcanvas__group-title">Mi cuenta</p>
                        <ul>
                            <li>
                                <a href="/my/garage"><i class="fa fa-truck" aria-hidden="true"/><span>Mi garage</span></a>
                            </li>
                            <li>
                                <a href="/my/addresses"><i class="fa fa-map-marker" aria-hidden="true"/><span>Mis direcciones</span></a>
                            </li>
                        </ul>
                    </div>
                </nav>

                <div class="vg-offcanvas__bottom">
                    <a t-if="vg_logged_in" href="/web/session/logout?redirect=/" class="vg-btn vg-btn--primary">
                        <i class="fa fa-sign-out" aria-hidden="true"/>
                        <span>Cerrar sesión</span>
                    </a>
                    <a t-else="" href="/web/login" class="vg-btn vg-btn--primary">
                        <i class="fa fa-sign-in" aria-hidden="true"/>
                        <span>Iniciar sesión</span>
                    </a>
                </div>
            </div>
        </div>
    </template>

    <!-- Garage panel (logged-in users only). Each card is a saved machine/vehicle and links to the
         shop with that combination applied; the card matching the current shop filters is
         highlighted and its model/year is shown on the header button. -->
    <template id="vegusa_garage_panel" name="Vegusa - Garage Panel">
        <t t-set="vg_garage_entries" t-value="request.env['machine.garage'].sudo()._get_header_entries(request.params.get('machine_model_id'), request.params.get('vehicle_year'))"/>
        <div class="vg-offcanvas" id="vgGaragePanel" hidden="hidden">
            <div class="vg-offcanvas__backdrop" data-offcanvas-close="1"/>
            <div class="vg-offcanvas__panel" role="dialog" aria-modal="true" aria-labelledby="vgGarageTitle">
                <div class="vg-offcanvas__top">
                    <button type="button" class="vg-offcanvas__close" data-offcanvas-close="1" aria-label="Cerrar">
                        <i class="fa fa-times" aria-hidden="true"/>
                    </button>
                    <h2 class="vg-offcanvas__title" id="vgGarageTitle">Mi garage</h2>
                </div>

                <div class="vg-offcanvas__scroll">
                    <ul t-if="vg_garage_entries" class="vg-garage-list">
                        <li t-foreach="vg_garage_entries" t-as="entry" t-key="entry['id']">
                            <a t-att-href="entry['url']" t-attf-class="vg-vehicle-card #{'is-selected' if entry['active'] else ''}" t-att-aria-current="'true' if entry['active'] else None">
                                <span class="vg-vehicle-card__brand" t-out="entry['brand']"/>
                                <span class="vg-vehicle-card__type" t-out="entry['type']"/>
                                <span class="vg-vehicle-card__spec">
                                    <span class="vg-vehicle-card__spec-item">
                                        <span class="vg-vehicle-card__spec-label">Modelo</span>
                                        <span class="vg-vehicle-card__spec-value" t-out="entry['model']"/>
                                    </span>
                                    <span t-if="entry['year']" class="vg-vehicle-card__spec-item">
                                        <span class="vg-vehicle-card__spec-label">Año</span>
                                        <span class="vg-vehicle-card__spec-value" t-out="entry['year']"/>
                                    </span>
                                </span>
                            </a>
                        </li>
                    </ul>
                    <p t-else="" class="vg-garage-empty">
                        Aún no has guardado ninguna maquinaria ni vehículo. Filtra la tienda por tu equipo y usa "Agregar a Mi garage".
                    </p>
                </div>

                <div class="vg-offcanvas__bottom">
                    <a href="/my/garage" class="vg-btn vg-btn--primary">
                        <i class="fa fa-cog" aria-hidden="true"/>
                        <span>Administrar Mi garage</span>
                    </a>
                </div>
            </div>
        </div>
    </template>

    <!-- Favoritos item of the side menu. Reuses what the header wishlist button used to check:
         the shop must be accessible; the count comes from product.wishlist. -->
    <template id="vegusa_side_wishlist_item" name="Vegusa - Side Menu Wishlist Item">
        <t t-set="wishcount" t-value="len(request.env['product.wishlist'].current())"/>
        <li t-if="website.has_ecommerce_access()">
            <a href="/shop/wishlist">
                <i class="fa fa-heart" aria-hidden="true"/>
                <span>Favoritos</span>
                <sup t-out="wishcount" t-attf-class="my_wish_quantity vg-menu-badge #{'d-none' if (wishcount == 0) else ''}"/>
            </a>
        </li>
    </template>

    <template id="footer" inherit_id="website.layout" name="Vegusa - Footer" active="True">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo footer-vegusa" t-ignore="true" t-if="not no_footer">
                <div class="row p-4 vw-100 me-0 ms-0">
                    <div class="col-12 col-lg-9 row pe-0 ps-0">
                        <article class="col-12 col-lg-4 d-flex flex-column gap-2 px-3 me-4 mb-4">
                            <h5>Atención al cliente</h5>
                            <div class="d-flex flex-column gap-1">
                                <a href="">Sobre nosotros</a>
                                <a href="mailto:holamaq@vegusa.com">holamaq@vegusa.com</a>
                                <a href="tel:4778134999">477 813 4999</a>
                                <a href="tel:4779801648">477 980 1648</a>
                                <span>Blvd. Aeropuerto 1401, San Carlos la Roncha, 37544 León de los Aldama, Gto.</span>
                                <span>Abierto de 9:00 a 18:00 hrs.</span>
                            </div>
                        </article>
                        <article class="col-12 col-lg-4 d-flex flex-column gap-2 px-3 me-4 mb-4">
                            <h5>Políticas y legal</h5>
                            <div class="d-flex flex-column gap-1">
                                <a href="">Política de devoluciones</a>
                                <a href="">Términos y condiciones</a>
                                <a href="">Aviso de privacidad</a>
                            </div>
                        </article>
                    </div>
                    <div class="col-12 col-lg-3 d-flex flex-column gap-2 ps-0 pe-0">
                        <img 
                            src="website_vegusa/static/src/img/content/logo_vegusa_white.webp"
                            alt="Vegusa"
                            class="vegusa-footer-logo"
                        />
                        <div class="s_social_media text-start o_not_editable" data-snippet="s_social_media" data-name="Social Media" contenteditable="false">
                            <h5 class="s_social_media_title d-none mb-2" contenteditable="true">Follow us</h5>
                            <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
                                <i class="fa fa-facebook rounded-circle shadow-sm o_editable_media"/>
                            </a>
                            <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank" aria-label="X">
                                <i class="fa fa-twitter rounded-circle shadow-sm o_editable_media"/>
                            </a>
                            <a href="/website/social/linkedin" class="s_social_media_linkedin" target="_blank" aria-label="LinkedIn">
                                <i class="fa fa-linkedin rounded-circle shadow-sm o_editable_media"/>
                            </a>
                            <a href="/" class="text-800" aria-label="Extra page">
                                <i class="fa fa-home rounded-circle shadow-sm o_editable_media"/>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="row p-4 vw-100 me-0 ms-0">
                    <div class="col-12 col-lg-6 d-flex justify-content-center justify-content-lg-start align-items-center gap-1 mb-4 mb-lg-0">
                        <img class="rounded-1 vegusa-payment-logo" src="/website_vegusa/static/src/img/content/americanexpress.svg" />
                        <img class="rounded-1 vegusa-payment-logo" src="/website_vegusa/static/src/img/content/mastercard.svg" />
                        <img class="rounded-1 vegusa-payment-logo" src="/website_vegusa/static/src/img/content/visa.svg" />
                        <img class="rounded-1 vegusa-payment-logo" src="/website_vegusa/static/src/img/content/paypal.svg" />
                        <img class="rounded-1 vegusa-payment-logo" src="/website_vegusa/static/src/img/content/mercadopago.svg" />
                    </div>
                    <div class="col-12 col-lg-6 d-flex justify-content-center justify-content-lg-end align-items-center">
                        <span>© 2024 Vegusa. Todos los derechos reservados.</span>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="copyright" inherit_id="website.layout">
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="replace">
            <div class="o_footer_copyright" data-name="Copyright">
                <img class="img-fluid" src="/website_vegusa/static/src/img/content/vegusa_footer_under.png" />
            </div>
        </xpath>
    </template>
</odoo>
