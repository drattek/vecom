# =====================================================================
# Plantilla de vecom.env (variables reales de despliegue)
#
#   cp vecom.env.example vecom.env
#
# vecom.env está en .gitignore: NUNCA se sube al repo. Lo lee
# infrastructure/azure/setup-containerapps.sh:
#   - las claves con PASSWORD, SECRET, TOKEN o _KEY se crean como SECRETOS de
#     la Container App (la variable apunta con secretref, el valor no queda
#     visible en la configuración ni en GitHub);
#   - el resto se cargan como variables de entorno normales.
#
# Formato: KEY=valor. Se aceptan comillas y finales de línea CRLF.
#
# En Azure el script ignora SERVER_PORT, SERVER_TLS_* y los hosts/puertos de
# Redis y RabbitMQ: los fija él, apuntando a las apps internas del entorno.
# =====================================================================

# ---------- Compartidas ----------
RABBITMQ_USER=vecom
# (secreto) se crea con este valor en el RabbitMQ del entorno
RABBITMQ_PASSWORD=

# ---------- core-orchestrator ----------
# (secreto) obligatorio, la app no arranca sin él
JWT_SECRET=
JWT_ISSUER=core-orchestrator
JWT_TTL_MINUTES=60
# (secreto) la MISMA clave con la que se cifraron las credenciales en MySQL
CONNECTION_CREDENTIALS_ENCRYPTION_KEY=
MYSQL_HOST=vecomdb.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_USER=
# (secreto)
MYSQL_PASSWORD=
MYSQL_DATABASE=ecommerce
# (secreto) opcional: token de Banxico SIE para el tipo de cambio
SIE_API_TOKEN=

# Opcionales (tienen default en config.go; descomenta para cambiarlos)
# MYSQL_MAX_OPEN_CONNS=25
# MYSQL_MAX_IDLE_CONNS=25
# MYSQL_CONN_MAX_LIFETIME_MINUTES=5
# MYSQL_CONN_MAX_IDLE_TIME_MINUTES=5
# TOKEN_REFRESH_POLL_INTERVAL_MINUTES=5
# TOKEN_REFRESH_LOOKAHEAD_MINUTES=15
# SYNC_QUEUE_POLL_INTERVAL_SECONDS=1800
# SYNC_QUEUE_BATCH_SIZE=10
# COMPATIBILITIES_FIX_RUN_AT_HOUR=12
# COMPATIBILITIES_FIX_RUN_AT_MINUTE=0
# LISTING_DISCOVERY_RUN_AT_HOUR=1
# LISTING_DISCOVERY_RUN_AT_MINUTE=0
# EXCHANGE_RATE_RUN_AT_HOUR=8
# EXCHANGE_RATE_RUN_AT_MINUTE=0
# SERVER_SHUTDOWN_TIMEOUT_SECONDS=25

# ---------- synapse-bridge ----------
NISSAN_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
NISSAN_JDBC_URL=
NISSAN_USERNAME=
# (secreto)
NISSAN_PASSWORD=

# ERP (D365 F&O): lakehouse del Link to Fabric, workspace DYN365-Fabric. Sustituye a Synapse.
# OJO: no confundir con dyn365_lakehouse (...-64uec74...), que solo tiene tablas de CFDI.
# Las vistas dyn.* se despliegan con: python3 infrastructure/fabric/deploy_views.py
FABRIC_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver
FABRIC_JDBC_URL=jdbc:sqlserver://adlavztiivku7pnndfokppbime-wvohqqni4wjehasvx3dhclsypu.datawarehouse.fabric.microsoft.com:1433;database=dataverse_vegusa_cds2_workspace_unq1552bea2e8d74bffb367119adb1a7;encrypt=true;trustServerCertificate=false;authentication=ActiveDirectoryServicePrincipal;loginTimeout=30
# client id del service principal (BI-PowerBI-Embedded, Colaborador de DYN365-Fabric)
FABRIC_USERNAME=
# (secreto)
FABRIC_PASSWORD=
# FABRIC_POOL_SIZE=3
# FABRIC_CONNECTION_TIMEOUT=60000
# FABRIC_MAX_LIFETIME=1800000

# Obligatorias (sin default en application.properties). Cron de Spring: 6 campos.
SYNC_STOCK_CRON=
SYNC_ITEMS_CRON=
SYNC_EXISTENCIAS_CRON=
SYNC_CRON_ZONE=America/Mexico_City

# ---------- Solo para setup-containerapps.sh (no llega a los contenedores) ----------
# Crea el túnel vecom-middleware y el DNS vecom-api.odo.mx. Permisos:
# Account > Cloudflare Tunnel:Edit y Zone > DNS:Edit sobre odo.mx. También puede exportarse.
CLOUDFLARE_API_TOKEN=
